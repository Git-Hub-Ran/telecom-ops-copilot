# Environment Configuration Template
#
# Copy this file to .env and fill in your values.
# The .env file is in .gitignore so secrets are not committed.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your actual values
#   # Never commit .env to git

# ============================================================================
# REQUIRED: Azure AI Foundry Configuration
# ============================================================================

# Azure AI Foundry project endpoint URL
# Where to get: Azure AI Foundry portal > Your Project > Project Details > Endpoint
# Format: https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
AZURE_FOUNDRY_PROJECT_ENDPOINT=<paste-your-Foundry-project-endpoint-url-here>

# Azure Tenant ID (GUID)
# Where to get: Azure Portal > Microsoft Entra ID > Overview > Tenant ID
# (formerly "Azure Active Directory")
# Format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Used for DeviceCodeCredential authentication (same as Colab secrets)
AZURE_TENANT_ID=<paste-your-Azure-tenant-id-guid-here>

# Foundry Vector Store ID for KB file search
# Where to get: Azure AI Foundry portal > Your Project > Resources > Vector Stores
# Used by ActAgent and RespondAgent for grounding answers in the knowledge base
VECTOR_STORE_ID=vs_RUhIersucd9In0EAafTaorBG

# ============================================================================
# OPTIONAL: Model Assignments (defaults provided in src/config.py)
# ============================================================================

# Uncomment to override default model assignments:
# CLASSIFIER_MODEL=gpt-4o-mini
# ACT_MODEL=gpt-4o
# ESCALATE_MODEL=gpt-4o
# RESPOND_MODEL=gpt-4o

# Note: gpt-4o and gpt-4o-mini deployments retire October 1, 2026.
# After retirement, update Foundry deployments to current model versions.

# ============================================================================
# OPTIONAL: Thresholds and Limits (defaults provided in src/config.py)
# ============================================================================

# Uncomment to override defaults:
# CLASSIFICATION_CONFIDENCE_THRESHOLD=0.6
# RETRY_BACKOFF_MS=250
# MAX_CONVERSATION_TURNS=10
